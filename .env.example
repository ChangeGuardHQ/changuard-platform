# Local development defaults. Use private, environment-specific credentials elsewhere.
# don't commit secrets to source control. Use a .env file to override these values.
# this file is an example of the required environment variables for local development.
# Copy this file to .env and fill in the values for your environment.
FRONTEND_PORT=5173
CONNECTOR_PORT=8081
# Keep the change API and Schema Registry on distinct host ports.
CHANGE_SERVICE_PORT=8082
CHANGE_SERVICE_USER=changeguard
CHANGE_SERVICE_PASSWORD=change-me
# Bind the authenticated change-service reader to a trusted internal organization.
# Match this organization to the connector integration that produces the events.
CHANGE_ORGANIZATION_ID=local
CHANGE_ORGANIZATION_READERS=changeguard
# Pause projection during maintenance while retaining group offsets and persisted records.
KAFKA_LISTENER_AUTO_STARTUP=true
KAFKA_PORT=9092
POSTGRES_PORT=5432
POSTGRES_DB=changeguard
POSTGRES_USER=changeguard
POSTGRES_PASSWORD=changeguard-local
# Maven clients use the published host port; containers use schema-registry:8081.
SCHEMA_REGISTRY_PORT=8083
SCHEMA_REGISTRY_URL=http://localhost:8083
GITHUB_WEBHOOK_SECRET=change-me
# Optional GitHub App connection APIs. The base stack needs no GitHub credentials.
# Fill these values before using docker-compose.github.yaml; that override enables connection management.
GITHUB_APP_ID=0
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY_FILE=
# Use a separate, random secret containing at least 32 bytes.
GITHUB_INSTALLATION_STATE_SECRET=
GITHUB_INSTALLATION_STATE_TTL=10m
# Internal organization, immutable GitHub account ID, and authenticated administrators are deployment-owned.
GITHUB_CONNECTION_ORGANIZATION_ID=
GITHUB_CONNECTION_ACCOUNT_ID=0
GITHUB_CONNECTION_ADMINISTRATORS=connector-admin
GITHUB_CONNECTION_USERNAME=connector-admin
GITHUB_CONNECTION_PASSWORD=
CODE_EVENTS_TOPIC=changeguard.code-events.v1
# Durable outbox relay. Pause polling with false while retaining HTTP intake.
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=50
OUTBOX_ACKNOWLEDGEMENT_TIMEOUT=10s
OUTBOX_LEASE_DURATION=60s
OUTBOX_RETRY_INITIAL_DELAY=1s
OUTBOX_RETRY_MAX_DELAY=30s
