# Environment variables and secrets
.env
.env.*
*.local

# Node.js / frontend build output
node_modules/
dist/
dist-ssr/
coverage/
.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Java / Maven / Gradle build output
target/
build/
.gradle/
*.class
*.jar
*.war
*.ear
hs_err_pid*

# Test and tooling output
__pycache__/
*.py[cod]
.nyc_output/
playwright-report/
test-results/

