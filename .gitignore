# Environment variables and secrets
.env
.env.*
!.env.example
*.local

# Node.js / frontend build output
node_modules/
dist/
dist-ssr/
coverage/
.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Java / Maven / Gradle build output
target/
build/
.gradle/
*.class
*.jar
*.war
*.ear
hs_err_pid*

# Test and tooling output
# Ignore rules do not untrack files already committed; repository hygiene CI checks that case.
__pycache__/
*.py[cod]
.cache/
.trivy-cache/
.security-rules/
.nyc_output/
playwright-report/
test-results/

# Scanner output belongs in CI artifacts; retain source configurations and report fixtures.
/backend-*-security.json
/frontend-*-security.json
/frontend/npm-audit.json
/codeql-results/
/semgrep.json
/semgrep.sarif

# Terraform local state and variables
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local runtime data and logs
logs/
*.log
*.pid
*.seed
*.dump
*.sql.gz

# IDE and operating-system files
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
.DS_Store
Thumbs.db
*.swp
*.swo

# Local certificates and keystores
.aws/
.kube/
.ssh/
*.pem
*.key
*.p12
*.pfx
*.jks
