# Copy to deploy/.env on EC2; the real file and private keys remain outside Git.
# Replace the example IP with the instance's public IPv4. sslip.io supplies temporary DNS.
SITE_ADDRESS=203.0.113.10.sslip.io
ORGANIZATION_ID=visual-test
# This one visual-test account is bound to both APIs. Enter it in both Connections account fields.
APP_USERNAME=tester
APP_PASSWORD=
# Use separate random values, e.g. openssl rand -hex 32 for each secret.
POSTGRES_PASSWORD=
GITHUB_WEBHOOK_SECRET=
GITHUB_INSTALLATION_STATE_SECRET=
# App registration and immutable repository-owner account ID from github.com.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CONNECTION_ACCOUNT_ID=
# External file owned/readable by container UID 10001; never place the PEM in the checkout.
GITHUB_APP_PRIVATE_KEY_FILE=/opt/changeguard-secrets/github-app.pem
