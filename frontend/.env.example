# Public browser settings; never put passwords or GitHub App keys in VITE_* variables.
VITE_API_BASE_URL=/api
VITE_ORGANIZATION_ID=local
# Server-only targets for a host-run Vite dev/preview server. Compose supplies internal addresses.
CHANGE_API_PROXY_TARGET=http://localhost:8082
CONNECTOR_API_PROXY_TARGET=http://localhost:8081
